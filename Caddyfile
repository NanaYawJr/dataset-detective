# Web server for the built site. The host (Railway) provides HTTPS and sets PORT.
{
	admin off
	auto_https off

	# The container is only reachable through the host's own proxy, so the
	# visitor's address is taken from the header that proxy sets.
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
		client_ip_headers X-Real-IP X-Forwarded-For
	}
}

# The small server behind /api. The visitor's address is passed on for counting and
# limits; it is used in memory only and never stored.
(api) {
	reverse_proxy 127.0.0.1:{$API_PORT:8000} {
		header_up X-Client-IP {client_ip}
		header_up -X-Forwarded-For
		header_up -X-Real-IP
	}
}

:{$PORT:8080} {
	root * {$SITE_ROOT:/srv}

	# No access log is configured, so requests and addresses are not written down here.
	# Usage is counted anonymously by the small server behind /api (see PRIVACY.md).

	header {
		# The same policy as the page's own <meta> tag (see vite.config.ts), plus
		# frame-ancestors, which only works as a header. connect-src 'self' is what
		# backs the privacy promise: the page can only fetch its own files.
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	# Built files have a fingerprint in their name, so they can be cached for good.
	# The page itself is always re-checked, so a new release shows up straight away.
	@fingerprinted path /assets/*
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
	@page not path /assets/* /api/*
	header @page Cache-Control "no-cache"

	# The small server behind /api (usage counts and explanations) listens only inside the
	# container; these two blocks are the one way in.
	# A report summary for an explanation can be a few dozen kilobytes.
	handle /api/explain {
		request_body {
			max_size 256KB
		}
		import api
	}

	# Everything else under /api is tiny: usage signals and the stats page.
	handle /api/* {
		request_body {
			max_size 2KB
		}
		import api
	}

	handle {
		encode zstd gzip
		file_server {
			precompressed br gzip
		}
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
